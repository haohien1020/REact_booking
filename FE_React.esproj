<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6778455">
  <PropertyGroup>
    <StartupCommand>powershell -NoProfile -ExecutionPolicy Bypass -File scripts/npm.ps1 dev</StartupCommand>
    <BuildCommand>powershell -NoProfile -ExecutionPolicy Bypass -File scripts/npm.ps1 build</BuildCommand>
    <ShouldRunBuildScript>true</ShouldRunBuildScript>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
  </PropertyGroup>
</Project>
